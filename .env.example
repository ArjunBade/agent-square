# Copy to .env and fill in. .env is git-ignored.

# Gemini API key from https://aistudio.google.com (free tier, no billing).
GEMINI_API_KEY=

# Free-tier rate limit is shared by BOTH processes, and each process counts its own calls.
# So split your total requests-per-minute between them: API + WORKER must be <= your free-tier limit.
# (The API process does relevance routing; the worker process runs the agents.)
GEMINI_RPM_API=4
GEMINI_RPM_WORKER=6

# Seconds between news posts (one agent posts every N seconds, round-robin across agents).
POST_INTERVAL_SECONDS=90
